{
  "name": "dailyworkmate",
  "version": "1.4.0",
  "description": "DailyWorkMate — AI assistant, authorized workspaces and persistent terminals",
  "main": "./out/main/index.js",
  "author": {
    "name": "DailyWorkMate contributors"
  },
  "homepage": "https://github.com/SecondBrainSystem/DailyWorkMate",
  "license": "GPL-3.0",
  "scripts": {
    "companion:setup": "node scripts/setup-companion.cjs",
    "companion:speech:setup": "node scripts/setup-local-speech.cjs",
    "dev": "node scripts/dev.js",
    "dev:win": "electron-vite dev",
    "test": "node scripts/test.cjs",
    "typecheck": "npm run typecheck:main && npm run typecheck:renderer",
    "typecheck:main": "tsc -p tsconfig.node.json",
    "typecheck:renderer": "tsc -p tsconfig.json",
    "check:source-artifacts": "node scripts/check-source-artifacts.js",
    "build": "npm run check:source-artifacts && electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "start:sandbox": "electron . --no-sandbox",
    "prebuild:check": "node scripts/prebuild-check.js",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:win32": "npm run build && electron-builder --win --ia32",
    "build:mac": "npm run build && electron-builder --mac",
    "build:mac-arm": "npm run build && electron-builder --mac --arm64",
    "build:linux": "npm run build && electron-builder --linux",
    "build:all": "npm run build && electron-builder --win --mac --linux",
    "release": "node scripts/release.js",
    "icons": "node scripts/generate-brand-icons.cjs",
    "build:folder": "npm run build && node scripts/package-folder.cjs"
  },
  "dependencies": {
    "@koa/router": "^15.3.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ali-oss": "^6.23.0",
    "axios": "^1.7.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.3.9",
    "eventsource-parser": "^3.0.6",
    "i18next": "^25.8.11",
    "i18next-browser-languagedetector": "^8.2.1",
    "js-sha3": "^0.9.3",
    "koa": "^2.15.3",
    "koa-bodyparser": "^4.4.1",
    "koa-router": "^12.0.1",
    "lucide-react": "^0.454.0",
    "mime-types": "^3.0.2",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "react-window": "^2.2.7",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^2.5.4",
    "three": "0.186.1",
    "unified": "^11.0.5",
    "zstd-codec": "^0.1.5",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/koa": "^2.15.0",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa-router": "^7.4.8",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-window": "^1.8.8",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "canvas": "^3.2.1",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.47",
    "rcedit": "5.0.2",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "build": {
    "afterPack": "scripts/package-app.cjs",
    "npmRebuild": false,
    "appId": "com.dailyworkmate.desktop",
    "productName": "DailyWorkMate",
    "copyright": "Copyright © 2026 DailyWorkMate Team",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "build",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "sha3_wasm_bg.7b9ca65ddd.wasm",
        "to": "sha3_wasm_bg.7b9ca65ddd.wasm"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/electron-updater/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.companion.mac.plist",
      "entitlementsInherit": "build/entitlements.companion.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "DailyWorkMate uses the microphone for voice conversations with your virtual companion."
      },
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DailyWorkMate",
      "license": "LICENSE",
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "maintainer": "DailyWorkMate contributors",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "desktop": {
        "Name": "DailyWorkMate",
        "Comment": "AI assistant, workspaces and terminal",
        "Categories": "Utility;Network;",
        "StartupWMClass": "dailyworkmate"
      }
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "deb": {
      "priority": "optional",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "SecondBrainSystem",
        "repo": "DailyWorkMate"
      }
    ]
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SecondBrainSystem/DailyWorkMate.git"
  },
  "bugs": {
    "url": "https://github.com/SecondBrainSystem/DailyWorkMate/issues"
  }
}
